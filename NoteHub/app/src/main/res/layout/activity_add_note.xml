<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".AddNoteActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Název poznámky -->
        <EditText
            android:id="@+id/editTextTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Název poznámky"
            android:inputType="textCapSentences"
            android:layout_marginBottom="12dp" />

        <!-- Obsah poznámky -->
        <EditText
            android:id="@+id/editTextContent"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:gravity="top"
            android:hint="Obsah poznámky"
            android:inputType="textMultiLine"
            android:layout_marginBottom="20dp" />

        <!--popisek a výběr priority -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Priorita" />

        <Spinner
            android:id="@+id/spinnerPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:entries="@array/priority_names" />

        <!-- NOVÉ: kategorie -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kategorie" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:entries="@array/category_names" />

        <!-- datum vytvoření, jen informativně -->
        <TextView
            android:id="@+id/textCreatedAtInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vytvořeno: ---"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="20dp" />

        <!-- Tlačítko pro uložení -->
        <Button
            android:id="@+id/btnSaveNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uložit poznámku" />
    </LinearLayout>
</ScrollView>
